# etf-radar 运行时配置（复制为 config.env，只在服务器上填写，deploy 永不覆盖）
#
# --- LLM（OpenAI 兼容端点，用于消息面情绪评分与日报综述；留空则降级为纯技术面）---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=
#
# --- 邮件（任一SMTP服务商: QQ/163/sohu/Gmail等; 465=SSL, 587=STARTTLS）---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 日报+周报收件人，逗号分隔
MAIL_TO=
#
# --- 飞书告警（管道失败/爆破告警，复用现有机器人；留空则只记日志）---
FEISHU_WEBHOOK=
#
# --- web（etf.example.com，Caddy 反代到 127.0.0.1:8891）---
WEB_DOMAIN=etf.example.com
WEB_PORT=8891
WEB_BIND=127.0.0.1
# 口令经 `python3 web.py init <口令>` 写入 web_config.json，此处不放明文
