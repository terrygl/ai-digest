# ai-digest configuration — copy to config.env ON THE SERVER and fill in.
# config.env holds secrets: never commit it, never deploy it from your laptop.

# ==== LLM: any OpenAI-compatible endpoint ====
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1          model=gpt-4o-mini
#   Zhipu:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  model=glm-4-flash
#   Moonshot: LLM_BASE_URL=https://api.moonshot.cn/v1         model=kimi-k2-turbo-preview
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1        model=deepseek-chat
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ==== Push channels (all optional — leave empty to only write reports/) ====
# Telegram: create a bot with @BotFather, get chat_id via getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Feishu/Lark: group settings -> custom bot -> webhook.
# Safety setting: choose "custom keyword" (e.g. the word in your report title)
# — do NOT choose signature verification (not implemented).
FEISHU_WEBHOOK=

# ==== Filtering ====
# MIN_SCORE = weight*3 + keyword hits*2 + HN points/25 + GitHub stars/25
MIN_SCORE=11
MAX_ITEMS=40
